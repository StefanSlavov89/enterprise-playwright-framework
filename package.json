{
  "name": "enterprise-playwright-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "test:api": "npx playwright test --grep @api",
    "test:visual": "npx playwright test --grep @visual",
    "test:visual:update": "npx playwright test --grep @visual -u",
    "docker:test": "docker-compose run --rm test-runner npx playwright test",
    "docker:visual:update": "docker-compose run --rm test-runner npx playwright test --grep @visual -u",
    "docker:build": "docker-compose build"
  },
  "keywords": [],
  "author": "",
